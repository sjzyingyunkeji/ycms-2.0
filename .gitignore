# 依赖与构建缓存
frontend/node_modules/
frontend/dist/
frontend/*.log

# 本地快照（UI/源码的物理备份，不进版本库）
.snapshots/

# 本地开发临时文件（PHP 内置服务器日志、打包/截图临时产物）
php-server.log
php-server.*.log
*.pid
.tmp-*/
.tmp-*
.tmp-*.log

# 运行时数据（数据库、上传、备份、更新状态、密钥）
backend/storage/
public/storage/

# 本地环境变量
backend/.env
.env

# 发布产物（升级包与私钥请勿入库）
release/

# 内部文档草稿（需要对外发布的文档放 docs/，截图放 docs/screenshots/）
docs/private/
docs/*.local.md

# 系统/编辑器文件
.DS_Store
Thumbs.db
